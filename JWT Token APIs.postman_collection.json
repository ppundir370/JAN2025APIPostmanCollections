{
	"info": {
		"_postman_id": "d2b6704d-4f4a-464a-893a-a71e3832f4ef",
		"name": "JWT Token APIs",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "732190"
	},
	"item": [
		{
			"name": "1-Get JWT Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const JWTToken = pm.response.text();",
							"console.log(JWTToken);",
							"pm.collectionVariables.set(\"JWT_TOKEN\", JWTToken);",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/users/signin?username=admin&password=admin",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"users",
						"signin"
					],
					"query": [
						{
							"key": "username",
							"value": "admin"
						},
						{
							"key": "password",
							"value": "admin"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "2- User Me API",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"//call JWT AUTH api :",
							"const url = 'http://localhost:8080/users/signin';",
							"",
							"pm.sendRequest({",
							"  url: url,",
							"  method: 'POST',",
							"  header: {",
							"    'Content-Type': 'application/x-www-form-urlencoded'",
							"  },",
							"  body: {",
							"    mode: 'urlencoded',",
							"    urlencoded: [",
							"      { key: 'username', value: 'admin' },",
							"      { key: 'password', value: 'admin' }",
							"    ]",
							"  }",
							"}, function (err, response) {",
							"  if (err) {",
							"    console.error(err);",
							"    return;",
							"  }",
							"",
							"  console.log(\"res\",response.text());",
							"  pm.collectionVariables.set(\"MY_JWT_Token\", \"Bearer \" +response.text());",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "{{MY_JWT_Token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "http://localhost:8080/users/me",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"users",
						"me"
					]
				}
			},
			"response": []
		},
		{
			"name": "3-GetUserInfo",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{JWT_TOKEN}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "http://localhost:8080/users/admin",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"users",
						"admin"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "JWT_TOKEN",
			"value": ""
		},
		{
			"key": "MY_JWT_Token",
			"value": ""
		}
	]
}