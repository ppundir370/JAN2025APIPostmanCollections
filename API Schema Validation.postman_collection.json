	"item": [
		{
			"name": "1-GetUsers",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var schema = {",
							"  \"$schema\": \"http://json-schema.org/draft-07/schema#\",",
							"  \"title\": \"Generated schema for Root\",",
							"  \"type\": \"array\",",
							"  \"items\": {",
							"    \"type\": \"object\",",
							"    \"properties\": {",
							"      \"id\": {",
							"        \"type\": \"number\"",
							"      },",
							"      \"name\": {",
							"        \"type\": \"string\"",
							"      },",
							"      \"email\": {",
							"        \"type\": \"string\"",
							"      },",
							"      \"gender\": {",
							"        \"type\": \"string\"",
							"      },",
							"      \"status\": {",
							"        \"type\": \"string\"",
							"      }",
							"    },",
							"    \"required\": [",
							"      \"id\",",
							"      \"name\",",
							"      \"email\",",
							"      \"gender\",",
							"      \"status\"",
							"    ]",
							"  }",
							"}",
							"",
							"",
							"//AJV api:",
							"var Ajv = require('ajv');",
							"ajv = new Ajv();",
							"var data = pm.response.json();",
							"pm.test('API response schema check', function(){",
							"    pm.expect(ajv.validate(schema,data)).to.be.true;",
							"});",
							"",
							"",
							"pm.test('check users api schema', function(){",
							"    pm.response.to.have.jsonSchema(schema);",
							"});",
							"",
							"",
							"",
							"",
							"",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer e4b8e1f593dc4a731a153c5ec8cc9b8bbb583ae964ce650a741113091b4e2ac6"
					}
				],
				"url": {
					"raw": "https://gorest.co.in/public/v2/users",
					"protocol": "https",
					"host": [
						"gorest",
						"co",
						"in"
					],
					"path": [
						"public",
						"v2",
						"users"
					]
				}
			},
			"response": []
